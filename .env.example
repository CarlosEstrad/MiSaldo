# MiSaldo — example environment variables
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`
# (RNF-SEG-08). In production, these come from AWS Secrets Manager, not a file.

# PostgreSQL connection string used by EF Core migrations and the app at design
# time (read by DesignTimeDbContextFactory as MISALDO_DB). The application role
# MUST NOT have superuser or BYPASSRLS, so Row Level Security applies to it.
MISALDO_DB=Host=localhost;Port=5432;Database=misaldo;Username=misaldo_app;Password=change_me

# --- API (src/MiSaldo.Api) ---
# The API reads the connection string from ConnectionStrings__MiSaldo, or falls
# back to MISALDO_DB above.
# ConnectionStrings__MiSaldo=Host=localhost;Port=5432;Database=misaldo;Username=misaldo_app;Password=change_me

# Secret used to sign the backend's own JWT access tokens (HS256). At least 32
# bytes; generate one, e.g. PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# The host refuses to start without it.
JWT__SIGNING_KEY=

# Optional overrides (defaults shown).
# Jwt__Issuer=misaldo
# Jwt__Audience=misaldo-api
# Jwt__AccessTokenMinutes=30
# Jwt__RefreshTokenDays=14

# Login lockout and password reset (RF-AUT-06, RF-AUT-07).
# Authentication__MaxFailedLoginAttempts=5
# Authentication__LockoutDuration=00:15:00
# Authentication__PasswordResetTokenLifetime=01:00:00

# Argon2id cost for password hashes (OWASP defaults). Stored inside each hash,
# so raising them later does not invalidate existing passwords.
# Argon2__MemorySizeKiB=65536
# Argon2__Iterations=3
# Argon2__Parallelism=4

# Requests per minute (RNF-SEG-07): per client address on /api/v1/auth/*, per
# user (or address when anonymous) everywhere else.
# RateLimiting__AuthPermitLimit=10
# RateLimiting__GeneralPermitLimit=120
# RateLimiting__Window=00:01:00

# --- Placeholders for later phases (not used yet) ---

# Amazon SES (transactional email, F3+)
# SES_REGION=
# SES_FROM_ADDRESS=
