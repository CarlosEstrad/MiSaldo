# MiSaldo — example environment variables
# Copy this file to `.env` and fill in the values. NEVER commit a real `.env`
# (RNF-SEG-08); git already ignores it. In production these values come from
# the host's secret store (AWS Secrets Manager), not from a file.
#
# The same `.env` serves three things:
#   - Docker Compose reads it on its own (docker-compose.dev.yml).
#   - The EF Core migrations read MISALDO_DB.
#   - The API reads everything else once the file is loaded into the shell
#     (see "Entorno local" in the README).
# Values that contain `;` go in double quotes so the shell does not split them.

# --- Local environment (docker-compose.dev.yml) ---
# Passwords of the local containers. Letters and digits are enough; avoid `;`,
# `"`, `'` and `$` so they work inside the connection strings below.
POSTGRES_ADMIN_PASSWORD=change_me_admin
# misaldo_app, the role the API uses. It does NOT bypass Row Level Security.
# Created on the first start of an empty volume; changing it later needs
# ALTER ROLE misaldo_app PASSWORD '...' (or `docker compose down -v`).
MISALDO_APP_PASSWORD=change_me_app
# pgAdmin login (http://127.0.0.1:5050). Must look like a real address.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin
# Host ports, all published on 127.0.0.1 only (defaults shown).
# POSTGRES_PORT=5432
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# PGADMIN_PORT=5050

# --- Migrations ---
# Read by DesignTimeDbContextFactory (`dotnet ef database update`). The
# migrations run as the admin, who owns the tables; the API never uses it.
MISALDO_DB="Host=127.0.0.1;Port=5432;Database=misaldo;Username=misaldo_admin;Password=change_me_admin"

# --- API (src/MiSaldo.Api) ---
# Development enables /openapi/v1.json and, without SMTP, the in-memory notifier.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080

# The API connects as misaldo_app (same password as MISALDO_APP_PASSWORD).
ConnectionStrings__MiSaldo="Host=127.0.0.1;Port=5432;Database=misaldo;Username=misaldo_app;Password=change_me_app"

# Secret that signs the access tokens (HS256), at least 32 bytes. Generate it
# ONCE and keep it here: a new key on every start signs everyone out.
#   bash:       openssl rand -base64 48
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# The API refuses to start without it.
JWT__SIGNING_KEY=

# Optional overrides (defaults shown).
# Jwt__Issuer=misaldo
# Jwt__Audience=misaldo-api
# Jwt__AccessTokenMinutes=30
# Jwt__RefreshTokenDays=14

# --- Email (SMTP, decision D-13) ---
# One SMTP notifier; each stage only changes these values. Without Smtp__Host,
# Development keeps the tokens in memory (no email is sent) and Production
# refuses to start.
#
# Development: Mailpit from docker-compose.dev.yml (emails at http://127.0.0.1:8025).
Smtp__Host=127.0.0.1
Smtp__Port=1025
# StartTls, SslOnConnect or None. None (no encryption) is refused in Production.
Smtp__Security=None
Smtp__FromAddress=no-reply@misaldo.local
# Smtp__FromName=MiSaldo
# Seconds before a slow server is given up (the request is not held longer).
# Smtp__TimeoutSeconds=10
#
# Dedicated Gmail account (real deliveries, testing only). Needs 2-step
# verification and an app password (16 characters, without spaces):
#   Smtp__Host=smtp.gmail.com
#   Smtp__Port=587
#   Smtp__Security=StartTls
#   Smtp__Username=misaldo.pruebas@gmail.com
#   Smtp__Password=<app password>
#   Smtp__FromAddress=misaldo.pruebas@gmail.com
#
# Production: a transactional provider (Amazon SES, Postmark, ...) with the
# app's own domain, once SPF, DKIM and DMARC are set up:
#   Smtp__Host=email-smtp.us-east-1.amazonaws.com
#   Smtp__Port=587
#   Smtp__Security=StartTls
#   Smtp__Username=<SMTP user of the provider>
#   Smtp__Password=<SMTP password of the provider>
#   Smtp__FromAddress=no-reply@<your domain>

# --- Web frontend ---
# Base of the links in the emails: {BaseUrl}/verify-email?token=... and
# {BaseUrl}/reset-password?token=... Required when Smtp__Host is set; https in
# Production.
Frontend__BaseUrl=http://localhost:4200

# Origins allowed to call the API from a browser with credentials (CORS). One
# per index; scheme, host and optional port, no path and never `*`. https in
# Production. Without any, only same-origin requests work.
Cors__AllowedOrigins__0=http://localhost:4200
# Cors__AllowedOrigins__1=https://app.example.com

# --- Security limits (defaults shown) ---
# Login lockout and password reset (RF-AUT-06, RF-AUT-07).
# Authentication__MaxFailedLoginAttempts=5
# Authentication__LockoutDuration=00:15:00
# Authentication__PasswordResetTokenLifetime=01:00:00

# Argon2id cost for password hashes (OWASP defaults). Stored inside each hash,
# so raising them later does not invalidate existing passwords.
# Argon2__MemorySizeKiB=65536
# Argon2__Iterations=3
# Argon2__Parallelism=4

# Requests per minute (RNF-SEG-07): per client address on /api/v1/auth/*, per
# user (or address when anonymous) everywhere else.
# RateLimiting__AuthPermitLimit=10
# RateLimiting__GeneralPermitLimit=120
# RateLimiting__Window=00:01:00
